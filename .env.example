# Required: Cursor API key from https://cursor.com/dashboard/integrations
# Format: CURSOR_API_KEY=key_value  (no spaces around =)
CURSOR_API_KEY=

# Optional: model override (default: composer-2.5)
CURSOR_MODEL=composer-2.5

# Optional: Notion integration token for postmortem creation
# Get from https://www.notion.so/my-integrations
NOTION_TOKEN=

# Optional: parent page ID in Notion where incidents will be created
# Copy from the page URL: notion.so/workspace/<PAGE_ID>?v=...
NOTION_PARENT_PAGE_ID=

# Optional: PagerDuty integration (https://support.pagerduty.com/docs/api-access-keys)
# Requires uv/uvx installed: curl -LsSf https://astral.sh/uv/install.sh | sh
PAGERDUTY_USER_API_KEY=

# Optional: EU accounts use https://api.eu.pagerduty.com (default: US)
PAGERDUTY_API_HOST=

# Optional: help agent find the right incident
PAGERDUTY_SERVICE_NAME=checkout-service
PAGERDUTY_INCIDENT_ID=
