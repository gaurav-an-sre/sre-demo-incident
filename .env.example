# Required: Cursor API key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional: model override (default: composer-2.5)
CURSOR_MODEL=composer-2.5

# Optional: Notion integration token for postmortem creation
# Get from https://www.notion.so/my-integrations
NOTION_TOKEN=

# Optional: parent page ID in Notion where incidents will be created
# Copy from the page URL: notion.so/workspace/<PAGE_ID>?v=...
NOTION_PARENT_PAGE_ID=
